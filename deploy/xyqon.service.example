[Unit]
Description=XYQON blockchain node
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=xyqon
Group=xyqon
WorkingDirectory=/opt/xyqon
ExecStart=/usr/local/bin/xyqon node --listen 0.0.0.0:7101 --advertise YOUR_SERVER_IP:7101 --peers-file /etc/xyqon/peers.txt --trusted-miners-file /etc/xyqon/trusted-miners.json --chain /var/lib/xyqon/xyqon-chain.json
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
